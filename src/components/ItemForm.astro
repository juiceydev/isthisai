---
import type { Check, Verdict } from '../lib/store';

interface Props {
  item?: Check;
  defaultVerdict?: Verdict;
}

const { item, defaultVerdict = 'pending' } = Astro.props;
const verdict = item?.verdict ?? defaultVerdict;
const method = item?.method ?? 'human';
---

<form class="item" method="post" action="/api/admin/items">
  {item && <input type="hidden" name="id" value={item.id} />}

  <input
    class="url"
    type="url"
    name="url"
    required
    value={item?.url}
    placeholder="https://..."
    aria-label="URL"
  />

  <div class="item-row">
    <select name="verdict" aria-label="Verdict">
      <option value="pending" selected={verdict === 'pending'}>not checked</option>
      <option value="vibecoded" selected={verdict === 'vibecoded'}>Vibecoded</option>
      <option value="diffusion" selected={verdict === 'diffusion'}>
        Diffusion Generated
      </option>
      <option value="claude" selected={verdict === 'claude'}>Generated by Claude</option>
      <option value="unsure" selected={verdict === 'unsure'}>Unsure</option>
      <option value="possibly" selected={verdict === 'possibly'}>Possibly not AI</option>
      <option value="notai" selected={verdict === 'notai'}>Not AI!</option>
    </select>
    <select name="method" aria-label="How it was checked">
      <option value="human" selected={method === 'human'}>by eye</option>
      <option value="pangram" selected={method === 'pangram'}>pangram</option>
      <option value="other" selected={method === 'other'}>other</option>
    </select>
    <input
      type="url"
      name="pangram"
      value={item?.pangram}
      placeholder="pangram link"
      aria-label="Pangram link"
    />
  </div>

  <input
    class="note-input"
    name="note"
    maxlength="300"
    value={item?.note}
    placeholder="note (shown publicly)"
    aria-label="Note"
  />

  <div class="item-row item-actions">
    <button class="solid" name="action" value="save">save</button>
    {
      item && (
        <button
          class="ghost"
          name="action"
          value="delete"
          formnovalidate
          data-confirm="delete this item?"
        >
          delete
        </button>
      )
    }
    {
      item && (
        <a class="open" href={item.url} target="_blank" rel="noopener noreferrer nofollow">
          open ->
        </a>
      )
    }
    {
      item?.pangram && (
        <a class="open" href={item.pangram} target="_blank" rel="noopener noreferrer">
          pangram ->
        </a>
      )
    }
  </div>
</form>

{
  item && item.ip && (
    <form class="ban-row" method="post" action="/api/admin/bans">
      <input type="hidden" name="ip" value={item.ip} />
      <span class="sender">{item.ip}</span>
      <button class="ghost" name="action" value="ban">
        block sender
      </button>
    </form>
  )
}

