---
import Icon from './Icon.astro';
import type { Check } from '../lib/store';

interface Props {
  check: Check;
}

const { check } = Astro.props;

const verdicts = {
  pending: { label: 'Pending', icon: 'hourglass' },
  vibecoded: { label: 'Vibecoded', icon: 'coder' },
  diffusion: { label: 'Diffusion Generated', icon: 'diffusion' },
  claude: { label: 'Generated by Claude', icon: 'video' },
  unsure: { label: 'Unsure', icon: 'help' },
  possibly: { label: 'Possibly not AI', icon: 'alert' },
  notai: { label: 'Not AI!', icon: 'smile' },
} as const;

const hostname = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};

const title = check.title || hostname(check.url);
---

<li class="check" data-id={check.id}>
  <a
    class="thumb"
    href={check.url}
    target="_blank"
    rel="noopener noreferrer nofollow ugc"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      check.thumbnail ? (
        <img
          src={`/thumb/${check.id}`}
          alt=""
          width="320"
          height="180"
          loading="lazy"
          referrerpolicy="no-referrer"
        />
      ) : (
        <span class="thumb-empty">{hostname(check.url)}</span>
      )
    }
  </a>
  <a class="body" href={check.url} target="_blank" rel="noopener noreferrer nofollow ugc">
    <span class="title">{title}</span>
    <span class="sub">{check.description || check.author}</span>
  </a>
  <span class="verdict">
    {
      check.pangram ? (
        <a
          class={`tag ${check.verdict}`}
          href={check.pangram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Proof for ${title}`}
        >
          <Icon name={verdicts[check.verdict].icon} />
          {verdicts[check.verdict].label}
        </a>
      ) : (
        <span class={`tag ${check.verdict}`}>
          <Icon name={verdicts[check.verdict].icon} />
          {verdicts[check.verdict].label}
        </span>
      )
    }
    {check.note && <span class="note">{check.note}</span>}
  </span>
</li>
